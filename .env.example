# One-time bootstrap password for creating the first (only) account.
# It is checked against this env var and NEVER stored anywhere.
SETUP_PASSWORD=change-me

# Token for the Cloudflare tunnel (Zero Trust -> Networks -> Tunnels).
# Point the tunnel's public hostname osint.alt-dev.com at http://suron:3000
# Reusing an existing tunnel instead? Leave this EMPTY and copy
# docker-compose.hostport.example.yml to docker-compose.override.yml — Suron
# then publishes host port 3001 (3000 is Semaphore's on 192.168.1.10).
CLOUDFLARE_TUNNEL_TOKEN=

# WebAuthn relying party. Defaults target the production hostname;
# for local dev leave both unset (falls back to localhost:3000).
RP_ID=osint.alt-dev.com
RP_ORIGIN=https://osint.alt-dev.com

# Optional: Have I Been Pwned API key (haveibeenpwned.com/API/Key).
# When set, email scans also report breach exposure.
HIBP_API_KEY=
